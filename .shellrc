## EXPORTS ##
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export W3M_DIR="$XDG_DATA_HOME/w3m"
export PULSE_COOKIE="$XDG_CONFIG_HOME/pulse/cookie"
export TERM=xterm-256color
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export TODOTXT_DEFAULT_ACTION=ls
export TODOTXT_SORT_COMMAND='env LC_COLLATE=C sort -k1.4,1.4 -k2,2 -k1,1n'
export BROWSER="/usr/bin/firefox"
export PWBROWSER="/usr/bin/firefox --private-window"
export EDITOR="nvim"

## PATH ##
export PATH=$PATH:/usr/sbin
export PATH=$PATH:/sbin

# run startx in if in tty1
[ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ] && startx

# xterm color fix
[ $TERM = xterm ] && TERM=xterm-256color

# lines in history file
HISTSIZE=10000
SAVEHIST=10000

# ignore commands with a leading space
HISTCONTROL=ignoreboth
HISTIGNORE=' *'

# location of history file
HISTFILE=~/.history

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

## ALIASES AND FUNCTIONS ##

alias wget='wget --hsts-file="$XDG_DATA_HOME/wget-hsts"'

# docker aliases bc they can get really verbose sometimes
alias \
	d="docker" \
	dl="docker logs -f" \
	dc="docker-compose" \
	dcu="docker-compose up --remove-orphans -dV" \
	dcd="docker-compose down" \
	dcl="docker-compose logs -f" \
	dcdu="docker-compose down && docker-compose up --remove-orphans -dV" \
	dcul="docker-compose up --remove-orphans -dV && docker-compose logs -f" \
	dcdul="docker-compose down && docker-compose up --remove-orphans -dV && docker-compose logs -f" 

# edit the docker-compose.yml by container name/id and restart it immediately. good for repetative testing.
docker-edit () {
  compose_path="$(docker inspect $1 | grep com.docker.compose.project.config_files | cut -d'"' -f4)"
  save_path="$(pwd)"
  cd ${compose_path%/docker-compose.yml}
  $EDITOR $compose_path && docker compose down && docker compose up -d && docker compose logs -f
  cd $save_path
}

# backup file/dir
bak () {
  # in a for loop so it can work with a list of files/dirs
  for i in $@; do
    cp -r $i $i.bak
  done
}

#alias mirror='devour mpv av://v4l2:/dev/video0 --vf=hflip --profile=low-latency --untimed'

alias fm='fzmedia'
alias hg='history | grep'
alias ifconfig.me="curl ifconfig.me; echo"
alias bat="bat -p --theme base16"


# dat/docs shit
alias nd='PATHSTORE=$(pwd) && cd ~/dat/docs && nvim ~/dat/docs && cd $PATHSTORE && unset PATHSTORE'
alias n='PATHSTORE=$(pwd) && cd ~/dat/docs && nvim ~/dat/docs/quicknote.md && cd $PATHSTORE && unset PATHSTORE'
alias c='PATHSTORE=$(pwd) && cd ~/dat/docs && nvim ~/dat/docs/commands.md && cd $PATHSTORE && unset PATHSTORE'

# fuzzy cd util
# fzcd is the base function
fzcd () {
  [ -z $1 ] && return
  local fzdir=$(ls "$1" | fzy --vi)
  cd "$1/$fzdir"
}
# really opinionated child functions of fzcd parent function
cdr () { fzcd ~/dat/repos; } 
cdw () { fzcd ~/wrk; }
cdrw () { fzcd ~/dat/repos/qts; }
alias cdp='cd /etc/portage' #not a child fn of fzcd but it makes sense that it lives here to me

# vim in dir util
vd () {
  local PATHSTORE=$(pwd) #remember current path
  [ ! -e $@ ] && echo "file/directory does not exist" && return
  [ -f $@ ] && cd "${@%/*}" && vim "${@##*/}"
  if [ -d $@ ]; then
    local fzdir=$(ls "$1" | fzy --vi)
    cd $@/$fzdir
    vim .
  fi
  cd $PATHSTORE #go back to saved path
}
# more opinionated child functions, but this time for vd
vdr () { vd "$HOME/dat/repos/$@"; }
vdw () { vd "$HOME/wrk/$@"; }
vdrw () { vd "$HOME/dat/repos/qts/$@"; }

vdp () {
  local PATHSTORE=$(pwd) #remember current path
  cd /etc/portage
  sudo vim .
  cd $PATHSTORE #go back to saved path
}

reset_palette() {
  xrdb -query |
  awk -F'[: \t]+' '
    /^\*color[0-9]+:/ {
      n=$1; sub(/^\*color/,"",n)
      printf "\033]4;%s;%s\007", n, $2
      next
    }
    /^\*cursor(Color)?:/ { printf "\033]12;%s\007", $2; next }
    /^\*accent:/ { printf "\033]12;%s\007", $2; next }  # if you use accent as cursor
  ' > /dev/tty
  # reset to default blinking cursor (with tmux passthrough if needed)
  if [ -n "$TMUX" ]; then
    printf '\033Ptmux;\033\033[0 q\033\\' > /dev/tty
  else
    printf '\033[0 q' > /dev/tty
  fi
}

opencode() { command opencode "$@"; reset_palette; }

ocp() {
  local tmp
  tmp="$(mktemp)" || return 1
  trap 'rm -f "$tmp"' RETURN
  vim "$tmp" </dev/tty >/dev/tty 2>&1 || return $?
  opencode run "$(cat "$tmp")" #--agent g
}

