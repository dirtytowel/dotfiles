# timezones
alias CST='sudo timedatectl set-timezone America/Chicago && refreshbar.sh'
alias EST='sudo timedatectl set-timezone America/New_York && refreshbar.sh'

## FUNCTIONS ##

git_branch() {
  # Check if we are in a git repository
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || return

  # Store the output of git status to avoid multiple calls
  git_status=$(git status 2> /dev/null)

  # Get the current branch name
  branch=$(git symbolic-ref --short HEAD 2> /dev/null)
	[ -z "$branch" ] && branch="(detatched HEAD)"
  branch_notation=" $branch"

  # append git status condition to branch_notation
  case "$git_status" in
    *"ahead"*)
      branch_notation="$branch_notation >";;
    *"behind"*)
      branch_notation="$branch_notation <";;
    *"have diverged,"*)
      branch_notation="$branch_notation <>";;
    *"up to date"*)
      branch_notation="$branch_notation =";;
    *"conflicts"*)
      branch_notation="$branch_notation !!";;
  esac
  printf "$git_status" | grep -Eq 'untracked|modified' && \
    branch_notation="$branch_notation +"
  printf "$branch_notation"
}

ssh_check () {
	[ -z $SSH_TTY ] && echo "" || echo "($(cat /proc/sys/kernel/hostname)) "
}

get_pwd () {
  # Replace $HOME with '~'.
  get_pwd_p=$(pwd | sed "s|^$HOME|~|")
  # Root is a special case with no components to shorten.
  [ "$get_pwd_p" = "/" ] && { printf "/\n"; return; }
  # Remember and strip a leading '/' so absolute paths don't yield an empty component.
  case $get_pwd_p in
    /*) get_pwd_lead="/"; get_pwd_p=${get_pwd_p#/} ;;
    *)  get_pwd_lead="" ;;
  esac
  # Count components so the final directory can remain unshortened.
  get_pwd_n=$(printf "%s\n" "$get_pwd_p" | tr '/' '\n' | wc -l)
  get_pwd_i=0
  get_pwd_out=

  # Shorten every component to its first char (ignoring a leading '.'), except the last.
  while IFS= read -r get_pwd_d; do
    get_pwd_i=$((get_pwd_i + 1))
    if [ "$get_pwd_i" -eq "$get_pwd_n" ]; then
      get_pwd_seg=$get_pwd_d
    else
      get_pwd_seg=$(printf "%s" "${get_pwd_d#.}" | cut -b1)
    fi
    get_pwd_out="${get_pwd_out:+${get_pwd_out}/}${get_pwd_seg}"
  done <<EOF
$(printf "%s\n" "$get_pwd_p" | tr '/' '\n')
EOF

  printf "%s%s\n" "$get_pwd_lead" "$get_pwd_out"
}
